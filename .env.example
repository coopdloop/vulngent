# Copy to .env and fill in what you have. Every integration is optional except the LLM
# backend - agents will just report an ERROR string for tools they can't use.

# --- Database (defaults to a local SQLite file if unset) ---
DATABASE_URL=sqlite:///./vulngent.db

# --- LLM backend: Claude via OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# --- Auth: Sign in with Google / Microsoft (optional) ---
# Leave BOTH client ids blank to disable auth entirely (open local dev).
# Google: create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console.
GOOGLE_CLIENT_ID=
# Optional: restrict Google logins to a single Workspace domain (e.g. example.com).
GOOGLE_ALLOWED_DOMAIN=
# Microsoft (Entra ID): create an app registration (platform: Single-page application).
MICROSOFT_CLIENT_ID=
# Microsoft tenant: common, organizations, consumers, or a specific tenant id.
MICROSOFT_TENANT=common
# Set a stable random string so sessions survive server restarts (else ephemeral).
SESSION_SECRET=

# --- GitHub (issues, PR/commit tracking) ---
GITHUB_TOKEN=

# --- Slack (outreach) ---
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=

# --- Email / SMTP (outreach) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true

# --- Jira (project-management tracking) ---
JIRA_SERVER=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# --- Report whitelabeling (PDF/DOCX exports via `vulngent report`) ---
REPORT_COMPANY_NAME=vulngent
REPORT_TITLE=Vulnerability Remediation Report
REPORT_LOGO_PATH=
REPORT_PRIMARY_COLOR=#111827
REPORT_ACCENT_COLOR=#2563EB
REPORT_FOOTER_TEXT=Confidential — generated by vulngent
